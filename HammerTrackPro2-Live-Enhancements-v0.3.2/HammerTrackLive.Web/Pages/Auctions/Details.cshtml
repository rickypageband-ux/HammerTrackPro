@page "{slug}"
@model HammerTrackLive.Web.Pages.Auctions.DetailsModel
@{
    ViewData["Title"] = Model.Auction.Title;
}

<section class="detail-hero">
    <div class="shell detail-grid">
        <div class="detail-image"><img src="@Model.Auction.ImagePath" alt="" /></div>
        <div>
            <div class="eyebrow">@Model.Auction.Format.ToUpperInvariant() · PUBLISHED CATALOG</div>
            <h1>@Model.Auction.Title</h1>
            <p>@Model.Auction.Description</p>
            <dl class="detail-facts">
                <div><dt>Auction company</dt><dd>@Model.Auction.AuctionCompany</dd></div>
                <div><dt>Location</dt><dd>@Model.Auction.Location</dd></div>
                <div><dt>Lots</dt><dd>@Model.Auction.LotCount</dd></div>
                <div><dt>Closes</dt><dd>@Model.Auction.EndsAt.ToString("MMMM d, yyyy · h:mm tt zzz")</dd></div>
            </dl>
            <button class="button button-red" type="button" disabled>Registration opens in a later release</button>
        </div>
    </div>
</section>
<section class="section shell narrow">
    <div class="notice"><strong>Catalog preview only:</strong> Bidder registration, bids, cards, and payments are not accepted in this controlled release.</div>
    <h2>Auction information</h2>
    <div class="capability-grid">
        <div><b>Buyer premium</b><span>@Model.Details.BuyerPremiumPercent.ToString("0.##")%</span></div>
        <div><b>Sales tax</b><span>@Model.Details.SalesTaxPercent.ToString("0.##")% · @Model.Details.TaxBasis</span></div>
        <div><b>Payment</b><span>@Model.Details.PaymentInstructions</span></div>
        <div><b>Pickup</b><span>@Model.Details.PickupInstructions</span></div>
    </div>
    <h2>Catalog</h2>
    <div class="public-lot-grid">
        @foreach (var lot in Model.Details.Lots)
        {
            <article class="public-lot-card">
                @{ var image = lot.Media.FirstOrDefault(media => media.Kind == "Image"); }
                @if (image is not null) { <img src="/Media/Download?id=@image.Id" alt="@lot.Title" /> }
                <div><span>LOT @lot.LotNumber</span><h3>@lot.Title</h3><p>@lot.Description</p><strong>Starts at @lot.StartingBid.ToString("C") · @lot.Quantity item(s)</strong>
                @foreach (var document in lot.Media.Where(media => media.Kind == "Document")) { <a href="/Media/Download?id=@document.Id">PDF · @document.OriginalFileName</a> }</div>
            </article>
        }
    </div>
</section>
