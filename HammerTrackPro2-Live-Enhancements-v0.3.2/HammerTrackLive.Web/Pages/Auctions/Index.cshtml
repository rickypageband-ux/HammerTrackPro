@page
@model HammerTrackLive.Web.Pages.Auctions.IndexModel
@{
    ViewData["Title"] = "Auctions";
}

<section class="page-hero compact">
    <div class="shell">
        <div class="eyebrow">AUCTION MARKETPLACE</div>
        <h1>Auctions worth showing up for.</h1>
        <p>Browse published timed auctions from HammerTrack auction companies.</p>
    </div>
</section>
<section class="section shell">
    <div class="notice"><strong>Controlled marketplace preview:</strong> Published catalogs are real, but bidder registration and bidding remain disabled until the secured bidding release.</div>
    <div class="filter-bar" aria-label="Auction filters coming in the marketplace release">
        <span>All formats</span><span>All locations</span><span>Shipping available</span><span>Ending soon</span>
    </div>
    <div class="auction-grid">
        @if (Model.Auctions.Count == 0)
        {
            <div class="account-notice">No auctions are published yet. Please check back soon.</div>
        }
        @foreach (var auction in Model.Auctions)
        {
            <article class="auction-card">
                <a class="auction-image" asp-page="/Auctions/Details" asp-route-slug="@auction.Slug">
                    <img src="@auction.ImagePath" alt="" /><span>@auction.Status</span>
                </a>
                <div class="auction-card-body">
                    <div class="auction-format">@auction.Format · @auction.LotCount lots</div>
                    <h2><a asp-page="/Auctions/Details" asp-route-slug="@auction.Slug">@auction.Title</a></h2>
                    <p>@auction.Description</p>
                    <div class="auction-meta"><span>@auction.Location</span><span>Ends @auction.EndsAt.ToString("MMM d · h:mm tt")</span></div>
                </div>
            </article>
        }
    </div>
</section>
