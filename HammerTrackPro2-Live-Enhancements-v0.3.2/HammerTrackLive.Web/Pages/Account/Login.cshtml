@page
@model HammerTrackLive.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<section class="account-section">
    <div class="account-card">
        <div class="eyebrow">SECURE ACCOUNT ACCESS</div>
        <h1>Sign in</h1>
        <p>Accounts are currently invitation-only while the marketplace is in controlled development.</p>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <label asp-for="Input.Email"></label>
            <input asp-for="Input.Email" autocomplete="username" />
            <span asp-validation-for="Input.Email"></span>
            <label asp-for="Input.Password"></label>
            <input asp-for="Input.Password" autocomplete="current-password" />
            <span asp-validation-for="Input.Password"></span>
            <label class="checkbox-row"><input asp-for="Input.RememberMe" /> Keep me signed in on this device</label>
            <button class="button button-red" type="submit">Sign in</button>
            <a asp-page="/Account/ForgotPassword">Forgot your password?</a>
        </form>
    </div>
</section>
