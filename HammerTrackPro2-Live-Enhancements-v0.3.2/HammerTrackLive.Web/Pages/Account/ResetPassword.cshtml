@page
@model HammerTrackLive.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
}

<section class="account-section">
    <div class="account-card">
        <div class="eyebrow">ACCOUNT RECOVERY</div>
        <h1>Choose a new password</h1>
        @if (Model.ResetComplete)
        {
            <div class="account-notice">Your password has been changed. <a asp-page="/Account/Login">Sign in now.</a></div>
        }
        else
        {
            <form method="post">
                <div asp-validation-summary="ModelOnly"></div>
                <input asp-for="Input.Email" type="hidden" />
                <input asp-for="Input.Code" type="hidden" />
                <label asp-for="Input.Password"></label>
                <input asp-for="Input.Password" autocomplete="new-password" />
                <span asp-validation-for="Input.Password"></span>
                <label asp-for="Input.ConfirmPassword"></label>
                <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword"></span>
                <button class="button button-red" type="submit">Save new password</button>
            </form>
        }
    </div>
</section>
