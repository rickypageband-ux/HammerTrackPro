<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HammerTrackPro2</RootNamespace>
    <AssemblyName>HammerTrack</AssemblyName>
    <Version>0.7.49</Version>
    <AssemblyVersion>0.7.49.0</AssemblyVersion>
    <FileVersion>0.7.49.0</FileVersion>
    <Product>HammerTrack Pro</Product>
    <Company>HammerTrack Pro</Company>
    <ApplicationIcon>Assets\HammerTrackPro.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.13" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20260627" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.14" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HammerTrackPro2.Tests" />
    <EmbeddedResource Include="Assets\HammerTrackPro.png" />
  </ItemGroup>
</Project>
